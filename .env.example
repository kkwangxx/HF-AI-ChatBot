AI_API_BASE_URL=http://localhost:8080
AI_API_KEY=
AI_MODEL=my-model
# 可选模型列表（逗号分隔），供 WebUI 切换
AI_MODELS=my-model
# openai = /v1/chat/completions
# anthropic = /v1/messages（CC Switch Claude 配置常用）
AI_API_PROTOCOL=openai
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=120
APP_TITLE='AI Chat Bot'

# 监听地址，默认仅本机；确需对外提供服务再改为 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000

# 登录鉴权（无数据库，凭据直接来自此处）
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Cookie 签名密钥，留空则每次启动随机生成（重启后需重新登录）
AUTH_SECRET_KEY=
# 会话有效期（秒），默认 7 天
AUTH_SESSION_MAX_AGE_SECONDS=604800
# 通过 HTTPS 部署时设为 true
AUTH_COOKIE_SECURE=false

# Agent。设为 false 时恢复纯聊天，不调用工具
AGENT_ENABLED=true
AGENT_MAX_ROUNDS=6
# 代码项目，格式：标识=绝对路径，多个用分号分隔
# MOM_PROJECTS=backend=D:/mom/server;api=D:/mom/api;app=D:/mom/app;ui=D:/mom/ui
MOM_PROJECTS=
MOM_KNOWLEDGE_ROOT=mom_knowledge
# 只读查询。留空表示不启用数据库工具
MOM_DB_HOST=
MOM_DB_PORT=3306
MOM_DB_NAME=
MOM_DB_USER=
MOM_DB_PASSWORD=
